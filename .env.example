AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
# Optional: contoso.onmicrosoft.com — improves Exchange Admin API routing for app-only publish
AZURE_AD_ORG_DOMAIN=
NEXT_PUBLIC_APP_URL=http://localhost:3000
FINDMI_API_URL=https://alignment-api-khaki.vercel.app/api/dpm-alignment

# Site login (required in production). Comma-separated emails share AUTH_PASSWORD.
AUTH_EMAIL=kyle@dossaniparadise.com,ITSupport@dossaniparadise.com
AUTH_PASSWORD=
AUTH_SECRET=

# Shared workspace (signatures, directory, campaigns). Create a Vercel Blob store
# and paste the read-write token so both logins see the same data.
BLOB_READ_WRITE_TOKEN=
